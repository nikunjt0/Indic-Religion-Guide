# Add these to the project root .env — the bridge loads it via tsx --env-file=../.env

# BlueBubbles Server (running locally on this Mac)
BB_URL=http://localhost:1234
BB_PASSWORD=replace-with-server-password

# Already present in root .env, re-listed here for visibility — the bridge needs them too.
OPENAI_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
