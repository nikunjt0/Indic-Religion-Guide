rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Chat attachments (photos, video keyframes) a user sends are stored under
    // their own uid so past turns can re-render the thumbnails. Owner-only
    // read/write; the Admin SDK bypasses these rules.
    match /users/{uid}/chat-media/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Images only, capped at 10MB each — matches the downscaled JPEGs the
      // client produces and blocks arbitrary large uploads.
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
