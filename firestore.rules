rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write only their own profile. Admin SDK bypasses these rules.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Personal chat history lives in a subcollection, same ownership rule.
      match /chats/{chatId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Ritual guides and source metadata are public reads for any signed-in user
    // (including anonymous). Writes are server-only.
    match /ritualGuides/{slug} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /sources/{sourceId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Chunks and query audit logs are server-only — admin SDK writes, clients don't read.
    match /chunks/{chunkId} {
      allow read, write: if false;
    }
    match /queries/{queryId} {
      allow read, write: if false;
    }

    // Companion collections are server-only: the bridge and Next server use
    // the Admin SDK; browser clients never touch these directly.
    match /deliveryPreferences/{userId} {
      allow read, write: if false;
    }
    match /scheduledDeliveries/{deliveryId} {
      allow read, write: if false;
    }
    match /enrollments/{enrollmentId} {
      allow read, write: if false;
    }
    match /messageEvents/{eventId} {
      allow read, write: if false;
    }
    match /imessageUsers/{handleId} {
      allow read, write: if false;
      match /{document=**} {
        allow read, write: if false;
      }
    }
    match /programs/{programId} {
      // Published program metadata is publicly readable for the web catalog.
      allow read: if resource.data.status == 'published';
      allow write: if false;
      match /lessons/{lessonId} {
        allow read, write: if false;
      }
    }
    match /publicAnswers/{answerId} {
      // Only published answers are readable from the client; the server
      // renders them anyway, so this is defense in depth.
      allow read: if resource.data.reviewStatus == 'published';
      allow write: if false;
    }
  }
}
