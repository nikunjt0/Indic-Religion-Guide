# Firebase Web SDK (client) — safe to expose
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTHDOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECTID=
NEXT_PUBLIC_FIREBASE_STORAGEBUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGINGSENDERID=
NEXT_PUBLIC_FIREBASE_APPID=
NEXT_PUBLIC_FIREBASE_MEASUREMENTID=

# OpenAI (server-only — never prefix with NEXT_PUBLIC_)
OPENAI_API_KEY=

# Firebase Admin SDK (server-only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key as a single line with literal \n where newlines should be
FIREBASE_PRIVATE_KEY=

# --- Companion messaging (scheduled deliveries) ------------------------------
# Hard kill-switch for proactive/scheduled sends. Must be exactly "true" for
# the delivery queue to send real messages. Leave unset in development.
MESSAGING_SEND_ENABLED=
# Comma-separated normalized handles (+E.164 phone or lowercased Apple-ID
# email). When set, ONLY these recipients can receive scheduled messages —
# applies in every environment. Recommended outside production.
MESSAGING_TEST_ALLOWLIST=
# Fallback IANA timezone offered during onboarding confirmation.
DEFAULT_TIMEZONE=America/Chicago
# Canonical public origin for SEO pages, sitemap, and share links.
# (APP_PUBLIC_URL is the legacy name and still honored as a fallback.)
PUBLIC_APP_URL=
